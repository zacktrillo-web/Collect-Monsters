-- If a model named TheUnforgotten is already in Workspace, it is replaced in the same spot.
-- Otherwise the monster is placed in a row in front of the spawn. Press Play to see it move.

local existing = workspace:FindFirstChild("TheUnforgotten", true)
local destination = if existing then existing.Parent else workspace
local ORIGIN = if existing then existing:GetPivot() else CFrame.new(160, 0, -30) * CFrame.Angles(0, math.pi, 0)
local M = {}

local function cf(t)
	return ORIGIN * CFrame.new(table.unpack(t))
end

local function part(parent, class, name, size, frame, color, neon, shape)
	local p = Instance.new(class)
	p.Name = name
	p.Anchored = true
	p.Size = Vector3.new(size[1], size[2], size[3])
	p.CFrame = cf(frame)
	p.Color = Color3.fromHex(color)
	p.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	if shape then
		p.Shape = Enum.PartType[shape]
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
end

local function joint(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

