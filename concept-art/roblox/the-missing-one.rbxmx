    <Item class="Script" referent="RBX174"><Properties>
      <string name="Name">SignatureMove</string>
      <token name="RunContext">2</token>
      <ProtectedString name="Source"><![CDATA[-- SignatureMove: plays this monster's signature move on a loop.
-- The keyframes (child ModuleScript) are baked from the concept blockout by
-- concept-art/tools/export-roblox.mjs, so the motion matches the concept gallery.
-- RunContext is Client: every player animates their own copy, which keeps the motion smooth.
-- The server copy stays in its resting pose.
local RunService = game:GetService("RunService")

local model = script.Parent
local data = require(script:WaitForChild("Keyframes"))
local STEPS = data.steps

-- Joint models by name (names are unique within a monster).
local byName = {}
for _, d in model:GetDescendants() do
	if d:IsA("Model") then
		byName[d.Name] = d
	end
end

-- Each joint's resting transform relative to its parent joint (0 is this model).
local rest = {}
local joints = {}
for i, j in data.joints do
	local r = j.rest
	rest[i] = CFrame.new(r[1], r[2], r[3], r[4], r[5], r[6], r[7])
	joints[i] = byName[j.name]
	if not joints[i] then
		warn(`{model.Name}: SignatureMove can't find the joint "{j.name}", so the animation is off.`)
		return
	end
end

-- Where every joint sits at rest, and where each part sits relative to the joint that carries it.
local world = { [0] = model:GetPivot() }
for i, j in data.joints do
	world[i] = world[j.parent] * rest[i]
end
local parts, owner, offset = {}, {}, {}
for i, joint in joints do
	for _, child in joint:GetChildren() do
		if child:IsA("BasePart") then
			table.insert(parts, child)
			table.insert(owner, i)
			table.insert(offset, world[i]:ToObjectSpace(child.CFrame))
		end
	end
end

-- Keyframe m of joint j. Rotation-only tracks (stride 4) keep the joint's resting position.
local function key(j, m)
	local t, b = j.track, (m - 1) * j.stride
	if j.stride == 4 then
		return CFrame.new(j.rest[1], j.rest[2], j.rest[3], t[b + 1], t[b + 2], t[b + 3], t[b + 4])
	end
	return CFrame.new(t[b + 1], t[b + 2], t[b + 3], t[b + 4], t[b + 5], t[b + 6], t[b + 7])
end

-- Blend between the keys around step f. The cursor remembers the last key per joint,
-- so finding the next one is usually a single step.
local cursor = {}
local function pose(i, j, f)
	local times = j.times
	local n = #times
	local c = cursor[i] or 1
	if times[c] > f then
		c = 1
	end
	while c < n and times[c + 1] <= f do
		c += 1
	end
	cursor[i] = c
	local after = if c < n then times[c + 1] else STEPS
	local a = (f - times[c]) / (after - times[c])
	return key(j, c):Lerp(key(j, if c < n then c + 1 else 1), a)
end

local frames = table.create(#parts)
local start = os.clock()
RunService.Heartbeat:Connect(function()
	local f = ((os.clock() - start) / data.period % 1) * STEPS
	for i, j in data.joints do
		world[i] = world[j.parent] * (if j.times then pose(i, j, f) else rest[i])
	end
	for k, part in parts do
		frames[k] = world[owner[k]] * offset[k]
	end
	workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
end)
]]></ProtectedString>
    </Properties>
      <Item class="ModuleScript" referent="RBX175"><Properties>
        <string name="Name">Keyframes</string>
        <ProtectedString name="Source"><![CDATA[-- Keyframes for The Missing One's signature move, baked from the concept blockout.
-- times: key times in steps of 1/240 of a loop. track: position + rotation per key
-- (stride 7) or rotation only (stride 4). Rotations are quaternions (x, y, z, w).
return {
	period = 3.6,
	steps = 240,
	joints = {
		{ name = "Joint", parent = 0, rest = { 0, 1.5204, 0, 0, 1, 0, 0 }, times = { 0, 18, 34, 50, 66, 70, 73, 76, 81, 84, 87, 90, 93, 96, 98, 100, 102, 104, 106, 108, 110, 111, 112, 113, 140, 145, 149, 153, 157, 161, 165, 174, 180, 186, 192, 196, 201 }, stride = 7, track = { 0, 1.5204, 0, 0, 1, 0, 0, 0, 1.6068, 0, 0, 1, 0, 0, 0, 1.646, 0, 0, 1, 0, 0, 0, 1.6428, 0, 0, 1, 0, 0, 0, 1.5975, 0, 0, 1, 0, 0, 0, 1.5804, 0, 0, 1, 0.0018, 0, 0, 1.5663, 0, 0, 1, 0.0076, 0, 0, 1.5511, 0, 0, 0.9998, 0.0174, 0, 0, 1.5239, 0, 0, 0.9993, 0.0387, 0, 0, 1.5064, 0, 0, 0.9989, 0.0472, 0, 0, 1.4884, 0, 0, 0.9987, 0.0516, 0, 0, 1.4697, 0, 0, 0.9987, 0.0513, 0, 0, 1.4507, -0.0007, 0, 0.9992, 0.0395, 0, 0, 1.4313, -0.0132, 0, 0.9999, 0.0156, 0, 0, 1.4183, -0.0374, 0, 1, 0.0024, 0, 0, 1.4052, -0.0811, 0, 1, -0.0066, 0, 0, 1.3921, -0.15, 0, 0.9999, -0.0131, 0, 0, 1.3791, -0.2497, 0, 0.9998, -0.0218, 0, 0, 1.3661, -0.386, 0, 0.9994, -0.0337, 0, 0, 1.3532, -0.5646, 0, 0.9988, -0.0493, 0, 0, 1.3404, -0.7912, 0, 0.9976, -0.069, 0, 0, 1.334, -0.9243, 0, 0.9967, -0.0806, 0, 0, 1.3277, -1.0715, 0, 0.9956, -0.0934, 0, 0, 1.3215, -1.2, 0, 0.9945, -0.1045, 0, 0, 1.1862, -1.1996, 0, 0.9945, -0.1045, 0, 0, 1.1711, -1.1793, 0, 0.9947, -0.1027, 0, 0, 1.1618, -1.1408, 0, 0.995, -0.0994, 0, 0, 1.1552, -1.0826, 0, 0.9955, -0.0943, 0, 0, 1.1512, -1.0047, 0, 0.9962, -0.0876, 0, 0, 1.15, -0.9071, 0, 0.9969, -0.0791, 0, 0, 1.1515, -0.7897, 0, 0.9976, -0.0689, 0, 0, 1.1648, -0.4695, 0, 0.9992, -0.041, 0, 0, 1.1809, -0.2876, 0, 0.9997, -0.0251, 0, 0, 1.2025, -0.15, 0, 0.9999, -0.0131, 0, 0, 1.2289, -0.0568, 0, 1, -0.005, 0, 0, 1.2489, -0.0193, 0, 1, -0.0017, 0, 0, 1.2761, -0.0002, 0, 1, 0, 0 } },
		{ name = "Joint2", parent = 1, rest = { 0, 5.4, 0.1, 0, 0, 0, 1 }, times = { 0, 96, 101, 105, 109, 113, 135, 145, 155, 164, 180, 192, 201 }, stride = 4, track = { 0, 0, 0, 1, 0.0008, 0, 0, 1, 0.0065, 0, 0, 1, 0.0182, 0, 0, 0.9998, 0.0391, 0, 0, 0.9992, 0.0698, 0, 0, 0.9976, 0.0698, 0, 0, 0.9976, 0.0686, 0, 0, 0.9976, 0.0608, 0, 0, 0.9981, 0.0477, 0, 0, 0.9989, 0.0167, 0, 0, 0.9999, 0.0033, 0, 0, 1, 0, 0, 0, 1 } },
		{ name = "Joint3", parent = 2, rest = { 0, 0.85, 1.12, 0, 0, 0, 1 } },
