    <Item class="Script" referent="RBX106"><Properties>
      <string name="Name">SignatureMove</string>
      <token name="RunContext">2</token>
      <ProtectedString name="Source"><![CDATA[-- SignatureMove: plays this monster's signature move on a loop.
-- The keyframes (child ModuleScript) are baked from the concept blockout by
-- concept-art/tools/export-roblox.mjs, so the motion matches the concept gallery.
-- RunContext is Client: every player animates their own copy, which keeps the motion smooth.
-- The server copy stays in its resting pose.
local RunService = game:GetService("RunService")

local model = script.Parent
local data = require(script:WaitForChild("Keyframes"))
local STEPS = data.steps

-- Joint models by name (names are unique within a monster).
local byName = {}
for _, d in model:GetDescendants() do
	if d:IsA("Model") then
		byName[d.Name] = d
	end
end

-- Each joint's resting transform relative to its parent joint (0 is this model).
local rest = {}
local joints = {}
for i, j in data.joints do
	local r = j.rest
	rest[i] = CFrame.new(r[1], r[2], r[3], r[4], r[5], r[6], r[7])
	joints[i] = byName[j.name]
	if not joints[i] then
		warn(`{model.Name}: SignatureMove can't find the joint "{j.name}", so the animation is off.`)
		return
	end
end

-- Where every joint sits at rest, and where each part sits relative to the joint that carries it.
local world = { [0] = model:GetPivot() }
for i, j in data.joints do
	world[i] = world[j.parent] * rest[i]
end
local parts, owner, offset = {}, {}, {}
for i, joint in joints do
	for _, child in joint:GetChildren() do
		if child:IsA("BasePart") then
			table.insert(parts, child)
			table.insert(owner, i)
			table.insert(offset, world[i]:ToObjectSpace(child.CFrame))
		end
	end
end

-- Keyframe m of joint j. Rotation-only tracks (stride 4) keep the joint's resting position.
local function key(j, m)
	local t, b = j.track, (m - 1) * j.stride
	if j.stride == 4 then
		return CFrame.new(j.rest[1], j.rest[2], j.rest[3], t[b + 1], t[b + 2], t[b + 3], t[b + 4])
	end
	return CFrame.new(t[b + 1], t[b + 2], t[b + 3], t[b + 4], t[b + 5], t[b + 6], t[b + 7])
end

-- Blend between the keys around step f. The cursor remembers the last key per joint,
-- so finding the next one is usually a single step.
local cursor = {}
local function pose(i, j, f)
	local times = j.times
	local n = #times
	local c = cursor[i] or 1
	if times[c] > f then
		c = 1
	end
	while c < n and times[c + 1] <= f do
		c += 1
	end
	cursor[i] = c
	local after = if c < n then times[c + 1] else STEPS
	local a = (f - times[c]) / (after - times[c])
	return key(j, c):Lerp(key(j, if c < n then c + 1 else 1), a)
end

local frames = table.create(#parts)
local start = os.clock()
RunService.Heartbeat:Connect(function()
	local f = ((os.clock() - start) / data.period % 1) * STEPS
	for i, j in data.joints do
		world[i] = world[j.parent] * (if j.times then pose(i, j, f) else rest[i])
	end
	for k, part in parts do
		frames[k] = world[owner[k]] * offset[k]
	end
	workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
end)
]]></ProtectedString>
    </Properties>
      <Item class="ModuleScript" referent="RBX107"><Properties>
        <string name="Name">Keyframes</string>
        <ProtectedString name="Source"><![CDATA[-- Keyframes for Eternal Verdict's signature move, baked from the concept blockout.
-- times: key times in steps of 1/240 of a loop. track: position + rotation per key
-- (stride 7) or rotation only (stride 4). Rotations are quaternions (x, y, z, w).
return {
	period = 3.6,
	steps = 240,
	joints = {
		{ name = "Joint", parent = 0, rest = { 0, 4.1771, 0, 0, 1, 0, 0 }, times = { 0, 11, 23, 31, 40, 51, 60, 69, 76, 77, 78, 79, 80, 81, 82, 83, 84, 86, 87, 88, 89, 90, 91, 92, 94, 98, 99, 100, 101, 102, 103, 104, 105, 106, 107, 108, 109, 110, 112, 115, 119, 121, 124, 126, 129, 137, 150, 155, 162, 175, 180, 187, 193, 201, 211, 219, 226, 233 }, stride = 7, track = { 0, 4.1771, 0, 0, 1, 0, 0, 0, 4.1016, 0, 0, 1, 0, 0, 0, 4.18, 0, 0, 1, 0, 0, 0, 4.2, 0, 0, 1, 0, 0, 0, 4.1771, 0, 0, 1, 0, 0, 0, 4.1016, 0, 0, 1, 0, 0, 0, 4.1458, 0, 0, 1, 0, 0, 0, 4.1048, 0, 0, 1, 0, 0, 0, 4.1, 0, 0, 1, 0, 0, 0, 4.1184, 0, 0, 1, 0.0064, 0, 0, 4.199, 0, 0, 0.9994, 0.0346, 0, 0, 4.2626, 0, 0, 0.9984, 0.0567, 0, 0, 4.3111, 0, 0, 0.9973, 0.0736, 0, 0, 4.3466, 0, 0, 0.9963, 0.086, 0, 0, 4.3711, 0, 0, 0.9955, 0.0945, 0, 0, 4.3867, 0, 0, 0.995, 0.0999, 0, 0, 4.3953, 0, 0, 0.9947, 0.1029, 0, 0, 4.4, 0, 0, 0.9945, 0.1045, 0, 0, 4.3311, 0, 0, 0.9967, 0.0806, 0, 0, 4.2412, 0, 0, 0.9988, 0.0493, 0, 0, 4.1782, 0, 0, 0.9996, 0.0273, 0, 0, 4.1375, 0, 0, 0.9999, 0.0131, 0, 0, 4.1141, 0, 0, 1, 0.0049, 0, 0, 4.1033, 0, 0, 1, 0.0011, 0, 0, 4.0926, 0, 0, 1, -0.0013, 0, 0, 4.0323, 0, 0, 0.9999, -0.0118, 0, 0, 4.0906, 0, 0, 0.9999, 0.0104, 0, 0, 4.1719, 0, 0, 0.9992, 0.0403, 0, 0, 4.2282, 0, 0, 0.9981, 0.061, 0, 0, 4.2642, 0, 0, 0.9972, 0.0744, 0, 0, 4.2847, 0, 0, 0.9966, 0.082, 0, 0, 4.2945, 0, 0, 0.9963, 0.0856, 0, 0, 4.2983, 0, 0, 0.9962, 0.0868, 0, 0, 4.2447, 0, 0, 0.9977, 0.0678, 0, 0, 4.1397, 0, 0, 0.9995, 0.0305, 0, 0, 4.0744, 0, 0, 1, 0.0068, 0, 0, 4.0402, 0, 0, 1, -0.0062, 0, 0, 4.0286, 0, 0, 0.9999, -0.0115, 0, 0, 4.032, 0, 0, 0.9999, -0.0119, 0, 0, 4.0117, 0, 0, 0.9999, -0.0154, 0, 0, 4.0042, 0, 0, 0.9999, -0.0167, 0, 0, 3.982, 0, 0, 0.9998, -0.0206, 0, 0, 3.9675, 0, 0, 0.9997, -0.0231, 0, 0, 3.9694, 0, 0, 0.9997, -0.0228, 0, 0, 3.9867, 0, 0, 0.9998, -0.0198, 0, 0, 4.0711, 0, 0, 1, -0.005, 0, 0, 4.0426, 0, 0, 0.9999, -0.01, 0, 0, 4.0542, 0, 0, 1, -0.008, 0, 0, 4.0878, 0, 0, 1, -0.0021, 0, 0, 4.0795, 0,